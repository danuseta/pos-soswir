# ---- Database PostgreSQL (WAJIB) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=pos_db

# ---- Hanya untuk npm run db:migrate-mysql ----
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=pos_db

# ---- npm run db:init ----
# Password superadmin awal. Kosong = dibuatkan acak 16 karakter dan dicetak sekali.
INIT_SUPERADMIN_PASSWORD=

# ---- Auth (WAJIB) ----
JWT_SECRET=ganti-dengan-random-hex-64-byte

# ---- Server ----
NODE_ENV=development
PORT=3002
FRONTEND_URL=http://localhost:5173

# ---- Activity log cleanup (opsional) ----
CLEANUP_ENABLED=false
ACTIVITY_RETENTION_DAYS=3
CLEANUP_BATCH_SIZE=1000

# ---- PM2 monitoring (opsional) ----
MONITORING_PORT=9615
