# ---- Database (WAJIB) ----
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=pos_db

# ---- Auth (WAJIB) ----
JWT_SECRET=ganti-dengan-random-hex-64-byte

# ---- Server ----
NODE_ENV=development
PORT=3002
FRONTEND_URL=http://localhost:5173

# ---- Cloudinary (opsional, buat upload gambar produk) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Activity log cleanup (opsional) ----
CLEANUP_ENABLED=false
ACTIVITY_RETENTION_DAYS=3
CLEANUP_BATCH_SIZE=1000

# ---- PM2 monitoring (opsional) ----
MONITORING_PORT=9615
